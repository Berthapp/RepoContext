{
  "name": "repocontext",
  "version": "0.0.0-dev",
  "description": "Local-first, explainable project memory for AI coding agents. Installs the repoctx CLI — offline, deterministic, no telemetry, no LLM or embedding calls.",
  "keywords": [
    "ai",
    "agent",
    "context",
    "code-search",
    "typescript",
    "tree-sitter",
    "mcp",
    "cli",
    "tokens"
  ],
  "homepage": "https://berthapp.github.io/RepoContext/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Berthapp/RepoContext.git",
    "directory": "npm/repocontext"
  },
  "bugs": {
    "url": "https://github.com/Berthapp/RepoContext/issues"
  },
  "license": "Apache-2.0",
  "author": "RepoContext",
  "type": "commonjs",
  "bin": {
    "repoctx": "bin/repoctx.js"
  },
  "files": [
    "bin/repoctx.js",
    "lib/platform.js",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "optionalDependencies": {
    "repocontext-darwin-arm64": "0.0.0-dev",
    "repocontext-darwin-x64": "0.0.0-dev",
    "repocontext-linux-arm64": "0.0.0-dev",
    "repocontext-linux-x64": "0.0.0-dev",
    "repocontext-win32-arm64": "0.0.0-dev",
    "repocontext-win32-x64": "0.0.0-dev"
  },
  "publishConfig": {
    "access": "public"
  }
}
